rules_version = '2';

// Codera's database. Everything that can be posted lives in `posts`, told apart
// by `type`, so these few rules cover posts, shorts and videos alike.
service cloud.firestore {
  match /databases/{database}/documents {

    // The lowest build allowed to read anything.
    //
    // A shipped app is the one client that can never be fixed. Someone running
    // last month's desktop build has last month's rules: it doesn't know about
    // a country we have closed or an age check we have added, and nothing in
    // the app can reach it. The only thing it can't ignore is this file.
    //
    // Every current build stamps clients/{uid} with its number on sign-in. Set
    // this above 0 and anything that doesn't stamp — which is every build that
    // already exists — stops being answered. Raise it only once a new build has
    // been out long enough for people to have it, because it cuts off every
    // platform at once, the phone app included.
    //
    // While it is 0 the first term is true and no extra read is made.
    function minBuild() { return 0; }

    function current() {
      return minBuild() == 0
        || (exists(/databases/$(database)/documents/clients/$(request.auth.uid))
            && get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.build >= minBuild());
    }

    // A counter may only move by one at a time, and never below zero. Posts
    // written before likes and comments existed have none of these fields, so a
    // missing counter is read as zero rather than failing the rule outright.
    function step(was, now) {
      return now is int && now >= 0 && now >= was - 1 && now <= was + 1;
    }

    // Fields every kind of post carries. The author is whoever is signed in —
    // not whatever the app claims — and the time is the server's, so nobody can
    // post as someone else or pin a post to the top with a date in the future.
    function common(d) {
      return d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.likeCount == 0 && d.dislikeCount == 0 && d.commentCount == 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.authorName is string && d.authorName.size() <= 200
        && (d.authorPhoto == null || d.authorPhoto is string);
    }

    // A written post. Limits match the compose screen's own.
    function textPost(d) {
      return d.type == 'post'
        && d.keys().hasOnly(['uid', 'authorName', 'authorPhoto', 'type', 'title',
                             'body', 'code', 'lang', 'imageUrl', 'imagePath',
                             'imageUrls', 'imagePaths',
                             'likeCount', 'dislikeCount', 'commentCount', 'createdAt'])
        && (d.imageUrl == null || d.imageUrl is string)
        && (d.imagePath == null
            || d.imagePath.matches('images/' + request.auth.uid + '/[^/]+'))
        // Several pictures, swiped through. The first is also written to
        // imageUrl, so an app that predates the list still shows one rather
        // than nothing. Ten is the ceiling the compose screens set.
        && (d.imageUrls == null
            || (d.imageUrls is list && d.imageUrls.size() <= 10))
        // Rules can't test each item of a list, so unlike the single imagePath
        // these are not checked to be in the poster's own folder. Nothing is
        // read from them but a delete, and Storage refuses a delete of somebody
        // else's file whatever a post claims.
        && (d.imagePaths == null
            || (d.imagePaths is list && d.imagePaths.size() <= 10))
        && d.body is string && d.body.size() <= 4000
        && d.code is string && d.code.size() <= 8000
        && (d.body.size() > 0 || d.code.size() > 0)
        && (d.lang == null || d.lang is string);
    }

    // A short or a video. The file must sit in the poster's own folder, so a
    // post cannot claim someone else's upload as its own.
    function videoPost(d) {
      return d.type in ['short', 'video', 'live']
        && d.keys().hasOnly(['uid', 'authorName', 'authorPhoto', 'type', 'title',
                             'videoUrl', 'videoPath', 'duration', 'description',
                             'likeCount', 'dislikeCount', 'commentCount', 'createdAt'])
        && (d.get('description', null) == null
            || (d.description is string && d.description.size() <= 4000))
        && d.videoUrl is string
        && d.videoPath is string && d.videoPath.matches('videos/' + request.auth.uid + '/[^/]+')
        && (d.duration == null || d.duration is number);
    }

    match /posts/{postId} {
      allow read: if request.auth != null && current();

      allow create: if request.auth != null
        && common(request.resource.data)
        && (textPost(request.resource.data) || videoPost(request.resource.data));

      // The only edit anyone can make is to the three counters, and only by one
      // at a time — the votes and comments behind them have their own rules
      // below. Nothing else about a post can be changed after it is written.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'dislikeCount', 'commentCount'])
        && step(resource.data.get('likeCount', 0), request.resource.data.get('likeCount', 0))
        && step(resource.data.get('dislikeCount', 0), request.resource.data.get('dislikeCount', 0))
        && step(resource.data.get('commentCount', 0), request.resource.data.get('commentCount', 0));

      // Only the author can take a post down.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // One vote per person per post, and only your own.
    match /posts/{postId}/votes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.v in [1, -1]
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Comments: anyone signed in can read and write their own; the author of
    // the post can also clear one off their own post.
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorPhoto',
                                                 'text', 'createdAt']);
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
    }

    // How someone has dressed their own page: the banner across the top and
    // the picture on it. Anyone signed in can see them — they are part of how a
    // post looks — but only their owner can set them, and only to files in
    // their own Storage folder.
    match /profiles/{uid} {
      allow read: if request.auth != null && current();

      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['bannerUrl', 'bannerPath', 'bannerY', 'photoUrl', 'photoPath',
              'bio', 'links', 'username', 'updatedAt'])
        // Where else this person can be found. Five at most, and each one has
        // to be short enough to read; the app checks where they lead.
        && (!('links' in request.resource.data)
            || request.resource.data.links == null
            || (request.resource.data.links is list
                && request.resource.data.links.size() <= 5))
        && (!('username' in request.resource.data)
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 20))
        // Which strip of a tall picture the banner shows, as a percentage.
        && (!('bannerY' in request.resource.data)
            || (request.resource.data.bannerY is number
                && request.resource.data.bannerY >= 0
                && request.resource.data.bannerY <= 100))
        && (!('bio' in request.resource.data)
            || request.resource.data.bio == null
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 300))
        && (!('bannerPath' in request.resource.data)
            || request.resource.data.bannerPath == null
            || request.resource.data.bannerPath.matches('profile/' + uid + '/[^/]+'))
        && (!('photoPath' in request.resource.data)
            || request.resource.data.photoPath == null
            || request.resource.data.photoPath.matches('profile/' + uid + '/[^/]+'));
    }

    // Who holds which name. The document id is the name itself in lower case,
    // so the database can only ever hold one of each: a second person claiming
    // it would be writing a document that already exists, and create says no.
    // Nobody may take a name off someone else — only its owner can release it.
    match /usernames/{name} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 3 && name.size() <= 20
        && name.matches('[a-z0-9_]+');

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Who follows whom. The id is '<follower>_<followed>', so one person can only
    // ever hold one follow of another, and only their own.
    match /follows/{pair} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.at == request.time
        && pair == request.auth.uid + '_' + request.resource.data.to;

      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    // A live stream: who is on air, what they called it, and whether it is still
    // running (the streamer's app beats every few seconds; a silent stream is over). Only the streamer starts and ends one; the counters below it move
    // the way a post's do, one at a time, as people like or dislike it.
    match /streams/{streamId} {
      allow read: if request.auth != null && current();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.live == true
        && request.resource.data.likeCount == 0 && request.resource.data.dislikeCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorPhoto', 'title',
                                                 'live', 'watching', 'likeCount', 'dislikeCount',
                                                 'startedAt', 'endedAt', 'beat']);

      allow update: if request.auth != null
        && ((resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['live', 'watching', 'endedAt', 'beat', 'title', 'likeCount', 'dislikeCount']))
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likeCount', 'dislikeCount']))
        && step(resource.data.get('likeCount', 0), request.resource.data.get('likeCount', 0))
        && step(resource.data.get('dislikeCount', 0), request.resource.data.get('dislikeCount', 0));

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // One like or dislike per person per stream, as on a post.
    match /streams/{streamId}/votes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.v in [1, -1]
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The chat beside a stream. Anyone signed in can say something as themselves;
    // the streamer can clear anything off their own stream. A tip is money, so a
    // message can only claim one if the payment webhook wrote it.
    match /streams/{streamId}/chat/{msgId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorPhoto', 'text', 'at']);

      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/streams/$(streamId)).data.uid == request.auth.uid);
    }

    // How a viewer and a streamer find each other: the browser's own connection
    // details, left for the other side to pick up. Readable and writable by the
    // viewer they belong to and by whoever is streaming.
    function streamHost(streamId) {
      return get(/databases/$(database)/documents/streams/$(streamId)).data.uid;
    }

    match /streams/{streamId}/peers/{viewer} {
      allow read, write: if request.auth != null
        && (request.auth.uid == viewer || request.auth.uid == streamHost(streamId));

      match /{side}/{candidate} {
        allow read, write: if request.auth != null
          && (request.auth.uid == viewer || request.auth.uid == streamHost(streamId));
      }
    }

    // Whether a streamer can be tipped: their Stripe payout account is set up.
    // Anyone signed in can read it (it decides whether the Tip button shows);
    // only the Cloud Functions write it, after asking Stripe.
    match /payouts/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // What someone watches, kept for them alone: a handful of subjects with a
    // score each, which is how the feed knows to put Python before Rust.
    match /taste/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().size() <= 60;
    }

    // Each person's account record — for now, their Codera Plus status.
    // Readable only by its owner. Nothing in the app may write it: Plus is
    // switched on and off by the plusSubscribe / plusCancel Cloud Functions, so
    // it can't be granted by crafting a request.
    // Reports under the Community Standards: anyone signed in can report a post,
    // once. The app never reads them back; the onReport function counts them and
    // holds a post that enough people have reported.
    // Who you've blocked: only you can read or change your own list, and the
    // apps use it to keep you and them apart.
    match /blocks/{blockId} {
      allow read: if request.auth != null && resource.data.from == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['postId', 'kind', 'uid', 'reason', 'at'])
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['post', 'user', 'stream', 'chat'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.reason in ['off_topic', 'inappropriate', 'spam', 'harassment', 'other']
        && request.resource.data.at == request.time
        && (request.resource.data.get('kind', 'post') != 'post'
            || exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)));
    }

    // One number each: the moment this person turns 18, which is what decides
    // whether links off Codera open for them. Nobody else can read it. It can
    // be moved later — owning up to being younger — but never earlier.
    match /ages/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['adultAt', 'by', 'setAt'])
        && request.resource.data.adultAt is int
        && request.resource.data.setAt == request.time
        // Only ever their own word for it. 'face' is written by the function
        // that reads Yoti's answer, and admin writes don't come through here.
        && request.resource.data.by == 'self'
        && (!exists(/databases/$(database)/documents/ages/$(uid))
            || (resource.data.by == 'self'
                && request.resource.data.adultAt >= resource.data.adultAt));
      allow delete: if false;
    }

    // What each account last ran. Their own row only, and only the shape the
    // rules above read.
    match /clients/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'build', 'at'])
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 20
        && request.resource.data.build is int
        && request.resource.data.build >= 0;
    }

    // Read on launch so an old build can bow out with a civil screen rather
    // than a wall of permission errors. Written from the console, by us.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
