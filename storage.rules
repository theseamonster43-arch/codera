rules_version = '2';

// Codera's video files. Each person uploads only into their own folder,
// videos/{their uid}/, which is what makes "only your own" a one-line rule.
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{uid}/{file} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Pictures attached to posts, same rule: your own folder only.
    match /images/{uid}/{file} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The banner and picture someone chose for their own page. Same shape
    // again: your own folder, pictures only, and small enough to be one.
    match /profile/{uid}/{file} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
