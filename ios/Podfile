# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Codera' do
  config = use_native_modules!

  # Google Sign-In pulls in AppCheckCore, a Swift pod that imports these two
  # Objective-C pods. Built as static libraries (React Native's default) Swift
  # can only import them with module maps, so they're switched on for just
  # these two — not globally with use_modular_headers!, which breaks React's own
  # pods. Without this, `pod install` stops with "Swift pods cannot yet be
  # integrated as static libraries".
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-bottom-tabs (Apple's native Liquid Glass tab bar) imports
    # "RCTConversions.h" by bare name. React Native 0.87 no longer copies that
    # header into Pods/Headers, so the build fails with "file not found"; point
    # just that pod at React Native's Fabric folder where the header lives.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-bottom-tabs'
      target.build_configurations.each do |bc|
        paths = bc.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
        paths = paths.split(' ') if paths.is_a?(String)
        bc.build_settings['HEADER_SEARCH_PATHS'] =
          paths + ['"$(PODS_ROOT)/../../node_modules/react-native/React/Fabric"']
      end
    end
  end
end
